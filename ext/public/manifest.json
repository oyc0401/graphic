{
  "manifest_version": 3,
  "name": "PaintOn",
  "version": "0.1.0",
  "description": "PaintOn Chrome extension.",
  "permissions": ["contextMenus", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "PaintOn"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
