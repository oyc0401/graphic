        <mxCell id="6wiaA6puWI5cDe3y5h9X-43" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;sourseDisplacement&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;upload&lt;/font&gt;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;" parent="1" vertex="1">
