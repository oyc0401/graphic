        <mxCell id="6wiaA6puWI5cDe3y5h9X-23" value="하지만 픽셀유동화 캔슬은 어떻게 처리를 할까?" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
