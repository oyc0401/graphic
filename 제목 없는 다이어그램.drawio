        <mxCell id="6wiaA6puWI5cDe3y5h9X-35" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;sourseMap&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;upload&lt;/font&gt;&lt;/div&gt;" vertex="1">
